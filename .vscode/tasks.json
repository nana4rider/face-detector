{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Python: 仮想環境を作成",
      "type": "shell",
      "command": "python3 -m venv .venv",
      "problemMatcher": []
    },
    {
      "label": "Python: 依存パッケージをインストール",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "pip",
        "install",
        "--editable",
        "${workspaceFolder}[dev]"
      ],
      "dependsOn": "Python: 仮想環境を作成",
      "problemMatcher": []
    },
    {
      "label": "OpenAPI: JSONを生成",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "${workspaceFolder}/scripts/export_openapi.py"
      ],
      "problemMatcher": []
    },
    {
      "label": "Git: pre-commitフックを有効化",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/pre-commit",
      "args": [
        "install",
        "--hook-type",
        "pre-commit",
        "--hook-type",
        "pre-push"
      ],
      "dependsOn": "Python: 依存パッケージをインストール",
      "problemMatcher": []
    }
  ]
}
